# ─────────────────────────────────────────────────────────────
# Maison Noor — environment. Copy to .env.local (dev) and set the
# same keys in Vercel → Settings → Environment Variables (prod).
# The storefront runs fine without these; auth / DB / payments
# activate as each block is filled in. See SYSTEM.md.
# ─────────────────────────────────────────────────────────────

# ── Database (PostgreSQL) — Neon, Supabase, or Vercel Postgres ──
DATABASE_URL="postgresql://user:password@host:5432/noor?sslmode=require"

# ── Auth.js (NextAuth) ──
# Generate: openssl rand -base64 32
AUTH_SECRET=""
# Public site URL (prod: https://your-domain)
NEXTAUTH_URL="http://localhost:3000"

# "Continue with Google" — create an OAuth client at
# https://console.cloud.google.com → Credentials → OAuth client ID (Web).
# Authorized redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Magic-link email (optional) — any SMTP provider
EMAIL_SERVER="smtp://user:pass@smtp.host:587"
EMAIL_FROM="Maison Noor <hello@maisonnoor.pl>"

# ── Payments ──
# Stripe (cards, Apple/Google Pay). Przelewy24 & BLIK via Stripe PL or Autopay.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Admin access ──
# Comma-separated emails granted the ADMIN role on first sign-in.
ADMIN_EMAILS="you@example.com"
