# ─────────────────────────────────────────────────────────────
# Overtime — environment. Copy to .env.local for development.
# With nothing set, the app runs in DEMO MODE (persona sign-in, sample data).
# ─────────────────────────────────────────────────────────────

# demo | code | entra. Leave unset to auto-select:
#   entra  once the three AZURE_AD_* values exist
#   code   once ACCESS_CODE_AGENT and ACCESS_CODE_MONITORING exist
#   demo   otherwise
AUTH_MODE=

# ── Access-code sign-in (no SSO). See DEPLOY.md ──
ACCESS_CODE_AGENT=
ACCESS_CODE_MONITORING=
ACCESS_CODE_MANAGEMENT=
# Language of imported agents' confirmation email (fr | de | it | en | pl). Agents can change it.
DEFAULT_AGENT_LANGUAGE=fr

# ── Database. Neon / Supabase / Vercel Postgres. Unset = in-memory (local only) ──
DATABASE_URL=

# Required in production. Generate: openssl rand -base64 32
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3100

# ── Microsoft Entra ID (PRODUCTION sign-in) ──
# App registration → redirect URI: <NEXTAUTH_URL>/api/auth/callback/azure-ad
# Token configuration → add the "groups" claim (security groups).
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
# Object IDs of the Entra security groups that grant each role (everyone else = agent).
ENTRA_GROUP_MONITORING=
ENTRA_GROUP_MANAGEMENT=


# ── Product ──
NEXT_PUBLIC_ORG_NAME="Swisscom Customer Care"
NEXT_PUBLIC_APP_URL=http://localhost:3100
NEXT_PUBLIC_TIMEZONE=Europe/Warsaw
# Demo directory addresses (reserved domain; never real mailboxes)
DEMO_EMAIL_DOMAIN=example.com
