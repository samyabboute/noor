// Maison Noor — data model (PostgreSQL). Wire with: npx prisma migrate dev.
// Auth models follow the Auth.js (NextAuth) Prisma adapter shape.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Auth.js (NextAuth) — accounts, sessions, "Continue with Google", magic links
// ----------------------------------------------------------------------------
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(CUSTOMER)
  phone         String?
  createdAt     DateTime  @default(now())

  accounts  Account[]
  sessions  Session[]
  addresses Address[]
  orders    Order[]
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ----------------------------------------------------------------------------
// Catalogue
// ----------------------------------------------------------------------------
model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  tier        String
  active      Boolean  @default(true)
  // Localised copy stored as JSON: { pl, en }
  tagline     Json
  variety     Json
  origin      Json
  description Json?
  accent      String   @default("#C2A25A")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants   Variant[]
  orderItems OrderItem[]
}

model Variant {
  id        String  @id @default(cuid())
  productId String
  sku       String  @unique
  label     String // e.g. "250 g"
  priceMinor Int    // price in minor units (grosz), base currency PLN
  stock     Int     @default(0)
  weightG   Int?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------------------------------
// Orders
// ----------------------------------------------------------------------------
model Order {
  id            String      @id @default(cuid())
  number        String      @unique // e.g. NOOR-2418
  userId        String?
  email         String
  phone         String?
  status        OrderStatus @default(PENDING)
  currency      String      @default("PLN")
  subtotalMinor Int
  shippingMinor Int         @default(0)
  totalMinor    Int
  // Payment
  provider      String? // stripe | przelewy24 | blik
  paymentRef    String?
  // Fulfilment
  shipMethod    String? // inpost | courier
  giftMessage   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user     User?       @relation(fields: [userId], references: [id])
  items    OrderItem[]
  shipping Address?    @relation(fields: [addressId], references: [id])
  addressId String?
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  SHIPPED
  DELIVERED
  REFUNDED
  CANCELLED
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  productId  String?
  name       String
  sku        String?
  qty        Int
  priceMinor Int
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product? @relation(fields: [productId], references: [id])
}

model Address {
  id         String  @id @default(cuid())
  userId     String?
  fullName   String
  line1      String
  line2      String?
  city       String
  postalCode String
  country    String  @default("PL")
  phone      String?
  isDefault  Boolean @default(false)
  user       User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders     Order[]
}
